# Development can use the local API. Store builds require a public HTTPS endpoint.
# The privacy, terms, support and account-deletion links are served by the API itself
# (server PUBLIC_BASE_URL), so they are not repeated here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
EAS_PROJECT_ID=

# Set to 1 for a store build. It turns on the release gate in app.config.js, which refuses to
# build with missing settings, a non-HTTPS API or Google's test ad units still in app.json.
CUEMASTER_RELEASE=

# Development only: runs the on-device physics benchmark instead of the game.
# EXPO_PUBLIC_NATIVE_BENCHMARK=
