    "scheme": "cuemaster",
    "description": "A landscape 3D pool game with real physics: play online 1 vs 1, invite friends to private tables, or play computer rivals, with daily rewards, a season pass and six city venues.",
    "primaryColor": "#070f18",
    "backgroundColor": "#070f18",
    "assetBundlePatterns": [
