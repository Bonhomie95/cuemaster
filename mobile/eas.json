{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://cuemaster-api.onrender.com" },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "CUEMASTER_RELEASE": "1",
        "EXPO_PUBLIC_API_URL": "https://cuemaster-api.onrender.com"
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {}, "beta": {} }
}
