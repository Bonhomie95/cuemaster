# ---- Optional: raises Context7 doc rate limits -------------------------------
# Get it: https://context7.com/dashboard -> sign in -> API Keys -> Create
CONTEXT7_API_KEY=

# ---- Hyper3D Rodin: AI mesh generation via Blender MCP -----------------------
# A limited free trial key ships inside blender-mcp. For your own:
# Get it: https://hyper3d.ai -> Dashboard -> API Keys
HYPER3D_API_KEY=
# Alternate provider route for the same models:
# Get it: https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Sketchfab: model search + download --------------------------------------
# Get it: https://sketchfab.com/settings/password -> "API Token" (free account)
SKETCHFAB_API_TOKEN=

# ---- Tripo: text/image -> 3D -------------------------------------------------
# Get it: https://platform.tripo3d.ai -> API Keys (free credits on signup)
TRIPO_API_KEY=

# ---- Meshy (PAID - API access requires a Pro plan) ---------------------------
# Get it: https://www.meshy.ai/settings/api   (key starts with msy_)
MESHY_API_KEY=

# ---- Poly Haven: no key required. All assets are CC0. ------------------------

# ---- Game runtime ------------------------------------------------------------
VITE_PHYSICS_HZ=240
VITE_DEBUG_OVERLAY=false
