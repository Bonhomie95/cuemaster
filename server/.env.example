# production turns on the deployment guard in src/config.ts, which refuses to start unless
# the database, CORS origins, proxy trust and public policy URLs below are all set.
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27028
MONGODB_DB=cuemaster
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Comma-separated allowed OAuth client IDs. Empty = provider unavailable.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
APPLE_CLIENT_IDS=
# Required together before Apple sign-in is offered. Server secrets only.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Random 32-byte key encoded as 64 hex characters. Keep in a secrets manager;
# retain it while encrypted Apple refresh tokens exist. Never expose to Expo.
TOKEN_ENCRYPTION_KEY=
# Required in production. Exact trusted proxy addresses or CIDRs only, never true or *.
# Left empty behind a load balancer, Express sees the balancer's address for every request and
# every player shares a single rate-limit bucket.
TRUST_PROXY=

# Development only: the port `npm run dev` serves the web preview on. Defaults to a free port.
# WEB_PORT=

# Public site identity. Required in production: the store listings, the privacy policy and the
# account-deletion page all link here, and both stores check that the URLs resolve.
PUBLIC_BASE_URL=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_POLICY_DATE=
PUBLIC_COMPANY=Bonhomie LLC

# Reward crates and rubies. Both features stay off until these are configured, and no
# untested code path can mint currency while they are empty.
# ADS_PROVIDER enables the rewarded-video speed-up. STORE_BILLING enables ruby purchases,
# which also requires implementing verifyPurchase() in src/store.ts against the real provider.
ADS_PROVIDER=
STORE_BILLING=

# Where AdMob posts its signed reward callbacks. The signature is verified against Google's
# published keys; only override the key URL in tests.
# ADS_VERIFIER_KEYS_URL=
